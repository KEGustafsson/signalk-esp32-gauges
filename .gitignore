# PlatformIO
.pio
.cache
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.vscode
compile_commands.json

# Boat-specific credentials and addresses -- never committed.
# Template: include/secrets.example.h
# Anywhere in the tree: a project-local copy would also shadow the shared one.
# Also editor and merge leftovers (secrets.h~, secrets.h.bak, .orig).
secrets.h
secrets.h?*

# Host preview build output (tools/preview)
build/
out/

# Python bytecode (scripts/, tools/preview/)
__pycache__/

# PlatformIO build cache (build_cache_dir in each platformio.ini; CI too)
.pio-build-cache/

# The 2.1" project's own PlatformIO packages (core_dir in its platformio.ini):
# its framework is rebuilt, and must not replace the 4"'s in ~/.platformio.
.pio-core-2.1in/

# Generated in the 2.1" project by its framework rebuild (custom_sdkconfig):
# ESP-IDF's managed components, the merged sdkconfig per env, scratch.
waveshare-esp32-s3-touch-lcd-2.1/managed_components/
waveshare-esp32-s3-touch-lcd-2.1/.dummy/
waveshare-esp32-s3-touch-lcd-2.1/sdkconfig.defaults
waveshare-esp32-s3-touch-lcd-2.1/sdkconfig.*
